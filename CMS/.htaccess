# Apache Configuration for CMSv2
# Security & URL Rewriting

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Webserver-Fehler (z. B. 403 für gesperrte Pfade) über das CMS und die Fehlerseiten des aktiven Themes
# ausliefern. index.php erkennt sie an REDIRECT_STATUS. Bei Installation in einem Unterverzeichnis den Pfad anpassen.
ErrorDocument 400 /index.php
ErrorDocument 401 /index.php
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 405 /index.php
ErrorDocument 408 /index.php
ErrorDocument 410 /index.php
ErrorDocument 413 /index.php
ErrorDocument 414 /index.php
ErrorDocument 429 /index.php

# Fehlende statische Assets (siehe Rewrite-Regel unten) ohne PHP beantworten.
# Webserver ohne <If>-Unterstützung fallen auf die CMS-Fehlerseite zurück.
<IfModule mod_version.c>
    <IfVersion >= 2.4>
        <If "%{REQUEST_URI} =~ m#/(?:assets|themes|plugins|uploads)/.+\.(?:css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|bmp|woff2?|ttf|otf|eot|mp4|webm|mp3|ogg|wav|pdf|zip)$#i">
            ErrorDocument 404 "Not Found"
        </If>
    </IfVersion>
</IfModule>

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Standard-Einstieg explizit halten, falls der Host mehrere DirectoryIndex-
    # Kandidaten definiert.
    DirectoryIndex index.php

    # HTTPS-Strategie: Redirects werden verbindlich am Reverse-Proxy / VirtualHost
    # verwaltet. Diese ausgelieferte .htaccess setzt deshalb keinen lokalen
    # Produktiv-Redirect mehr, sondern normalisiert nur die Erkennung von HTTPS
    # für nachgelagerte Security-Header und Routing-Pfade.
    
    # Public optimized CSS/JS assets generated by AssetOptimizerService.
    # Keep this narrow allow-list before the private cache block below.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^cache/optimized-assets/[a-f0-9]{24}\.min\.(?:css|js)$ - [L,NC]

    # Block access to sensitive files and private runtime directories.
    RewriteRule ^(?:config\.php|\.env(?:\..*)?|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|README(?:\.md)?|Changelog(?:_old)?\.md)$ - [F,L,NC]
    RewriteRule ^\.git(?:/|$) - [F,L,NC]
    RewriteRule ^(?:config|core|logs|backups|cache)(?:/|$) - [F,L,NC]

    # Gebündelte PHP-Libraries werden ausschließlich serverseitig per Autoloader
    # geladen. vendor/ komplett sowie PHP-Dateien, Paket-Metadaten und versteckte
    # Dateien unter assets/ nie direkt ausliefern; CSS/JS/Fonts/Bilder bleiben frei.
    RewriteRule ^vendor(?:/|$) - [F,L,NC]
    RewriteRule ^assets/.*\.(?:php[0-9]?|phtml|phar|inc|ser|json|lock|md|dist|neon|ya?ml|xml|scss|sh)$ - [F,L,NC]
    RewriteRule ^assets/(?:.*?/)?\. - [F,L,NC]

    # Backup-/Editor-Artefakte (z. B. customizer.php.bak) nie ausliefern – sie enthalten oft PHP-Quelltext.
    RewriteRule \.(?:bak|old|orig|save|swp|swo|tmp|dist)$ - [F,L,NC]
    RewriteRule (?:^|/)\.(?:git|svn|vscode|idea|github)(?:/|$) - [F,L,NC]

    # Installer internals are only loaded server-side by install.php.
    RewriteRule ^install/.*\.php$ - [F,L,NC]

    # Disable executable uploads without Apache Directory-Container, because
    # those containers are not allowed in .htaccess context.
    RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|shtml|cgi|pl|py|sh|bash|ksh|zsh|asp|aspx|jsp|jspx|js[pm]|war)$ - [F,L,NC]
    RewriteRule ^uploads/(?:.*?/)?\. - [F,L,NC]

    # Private Uploads: Mitglieder-Dateien werden ausschließlich über /media-file
    # (MediaDeliveryService mit Besitzer-/Admin-Prüfung) ausgeliefert, Import-Quellen
    # des WordPress-Importers nur serverseitig gelesen.
    RewriteRule ^uploads/(?:member|import)(?:/|$) - [F,L,NC]
    RewriteRule ^plugins/cms-importer/(?:reports|wp_import|wp_import_files)(?:/|$) - [F,L,NC]

    # Public uploads must remain directly reachable by URL (media library,
    # public downloads and FontManager self-hosted fonts/CSS). Executables and
    # hidden files are blocked above before this passthrough can match.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^uploads/ - [L,NC]
    
    # Fehlende statische Assets unter assets/, themes/, plugins/ und uploads/
    # direkt mit 404 beantworten, statt für jeden Bot-Treffer das CMS zu starten.
    # Die schlanke Fehlerantwort setzt der <If>-Block unten.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:assets|themes|plugins|uploads)/.+\.(?:css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|bmp|woff2?|ttf|otf|eot|mp4|webm|mp3|ogg|wav|pdf|zip)$ - [R=404,L,NC]

    # Force routing through index.php for admin and member areas
    RewriteRule ^admin/ index.php [L,QSA]
    RewriteRule ^member/ index.php [L,QSA]
    
    # Route all requests through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # XSS Protection ist in modernen Browsern veraltet; CSP übernimmt den Schutz.
    Header always set X-XSS-Protection "0"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ── Content Security Policy (Fallback) ───────────────────────────────────
    # PHP setzt primär eine nonce-basierte CSP. Dieser Apache-Header dient nur
    # als Fallback, falls die PHP-Header nicht gesendet werden konnten.
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; trusted-types cms365 default sanitize-html dompurify; require-trusted-types-for 'script'"

    # ── HSTS – nur über HTTPS aktiv ──────────────────────────────────────────
    # Der Core setzt HSTS primär selbst, sobald HTTPS oder Proxy-HTTPS erkannt
    # wurde. Apache liefert nur den Fallback für exakt denselben Fall.
    Header always setifempty Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # ── Cross-Origin-Opener-Policy (COOP) ────────────────────────────────────
    # Isoliert das Browser-Fenster von fremden Origins.
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # ── Cross-Origin-Resource-Policy (CORP) ──────────────────────────────────
    Header always set Cross-Origin-Resource-Policy "same-site"

    # ── Permissions Policy ────────────────────────────────────────────────────
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

<IfModule mod_setenvif.c>
    # Reverse-Proxy-/CDN-HTTPS auf den lokalen HTTPS-Status abbilden, damit
    # HSTS und Security-Checks dieselbe Entscheidung treffen wie der Core.
    SetEnvIfNoCase X-Forwarded-Proto "^https$" HTTPS=on
    SetEnvIfNoCase X-Forwarded-Ssl "^on$" HTTPS=on
    SetEnvIfNoCase Request_URI "(^|/)uploads/" CMS_UPLOAD_REQUEST=1
    SetEnvIfNoCase Request_URI "(^|/)uploads/fonts/.*\.(?:css|woff2?|ttf|otf)(?:\?.*)?$" CMS_FONT_REQUEST=1
</IfModule>

# Disable PHP execution in uploads
# Hinweis: Der eigentliche Schutz erfolgt oben per RewriteRule. Apache
# Directory-Container dürfen in .htaccess nicht verwendet werden und würden
# auf Apache 2.4 zu 500ern führen.

# Protect config file
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# Protect config directory (double protection alongside config/.htaccess and RewriteRule)
# Verzeichnisschutz erfolgt Apache-konform über RewriteRule ^config/ und
# zusätzlich über CMS/config/.htaccess.

# Protect .htaccess
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# Set default charset
AddDefaultCharset UTF-8

# Explicit MIME types for self-hosted FontManager files and uploaded assets.
# This keeps fonts usable under X-Content-Type-Options: nosniff even on hosts
# with incomplete MIME maps.
<IfModule mod_mime.c>
    AddType text/css .css
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType image/avif .avif
    AddType image/webp .webp
</IfModule>

# Kompression – Brotli (bevorzugt) + Gzip/Deflate als Fallback (M-09)
<IfModule mod_brotli.c>
    # Qualitätsstufe 6 – gutes Verhältnis Kompression/CPU
    BrotliCompressionQuality 6
    AddOutputFilterByType BROTLI_COMPRESS \
        text/html text/plain text/xml text/css \
        text/javascript text/x-component \
        application/javascript application/x-javascript \
        application/json application/xml application/xhtml+xml \
        application/rss+xml application/atom+xml \
        image/svg+xml \
        font/woff font/woff2 font/truetype font/opentype \
        application/font-woff application/font-woff2 \
        application/vnd.ms-fontobject
</IfModule>

# Deflate als Fallback (kein Brotli-Modul vorhanden)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html text/plain text/xml text/css \
        text/javascript text/x-component \
        application/javascript application/x-javascript \
        application/json application/xml application/xhtml+xml \
        application/rss+xml application/atom+xml \
        image/svg+xml \
        font/woff font/woff2 font/truetype font/opentype \
        application/font-woff application/font-woff2 \
        application/vnd.ms-fontobject

    # Defekte Proxys umgehen
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# Vary: Accept-Encoding – verhindert Proxy-Caching von unkomprimierten Inhalten (M-09)
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|css|js|json|xml|svg|woff|woff2|ttf|otf|eot)$">
        Header append Vary "Accept-Encoding"
    </FilesMatch>
</IfModule>

# Browser caching – H-14: Expires + Cache-Control + ETag
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg            "access plus 1 year"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/gif            "access plus 1 year"
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/webp           "access plus 1 year"
    ExpiresByType image/avif           "access plus 1 year"
    ExpiresByType image/svg+xml        "access plus 1 month"
    ExpiresByType image/x-icon         "access plus 1 year"
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript      "access plus 1 month"
    ExpiresByType application/json     "access plus 0 seconds"
    ExpiresByType text/html            "access plus 0 seconds"
    ExpiresByType font/woff            "access plus 1 year"
    ExpiresByType font/woff2           "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control headers (H-14)
<IfModule mod_headers.c>
    <FilesMatch ".+">
        Header always set X-Content-Type-Options "nosniff" env=CMS_UPLOAD_REQUEST
    </FilesMatch>

    # FontManager self-hosted fonts live in uploads/fonts and must be usable
    # from direct URLs and same-site/CDN frontends.
    Header always set Access-Control-Allow-Origin "*" env=CMS_FONT_REQUEST
    Header always set Cross-Origin-Resource-Policy "cross-origin" env=CMS_FONT_REQUEST

    # Statische Bild-Assets – 1 Jahr, immutable (nie geändert ohne neuen Namen)
    <FilesMatch "\.(jpg|jpeg|gif|png|webp|avif|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Schriften – 1 Jahr
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS / JS – 1 Jahr (Templates nutzen Query-/Filemtime-Versionierung)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # JSON/XML/Text-Feeds – kurze TTL für öffentliche Maschinenformate
    <FilesMatch "\.(json|xml|txt)$">
        Header set Cache-Control "public, max-age=300, stale-while-revalidate=60"
    </FilesMatch>

    # HTML – kein Caching (dynamische Seiten)
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ETag: INode-Komponente deaktivieren (HTTP/1.1-kompatibel, sichere Cluster-Nutzung)
FileETag MTime Size

# Limit file upload size (nur mod_php; unter PHP-FPM/CGI wären php_value-
# Direktiven in .htaccess ungültig und würden den Request abbrechen.)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>
